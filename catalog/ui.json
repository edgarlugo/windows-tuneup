      "scope": "user",
      "set": { "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer", "name": "HideSCAMeetNow", "kind": "DWord", "value": 1 },
      "rebootRequired": false,
