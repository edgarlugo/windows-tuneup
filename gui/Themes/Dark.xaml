<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tokens of the dark theme (design, section 17.4). Light.xaml and HighContrast.xaml have the same keys. -->
    <SolidColorBrush x:Key="Bg" Color="#202020"/>
    <SolidColorBrush x:Key="Surface" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#323232"/>
    <SolidColorBrush x:Key="NavHover" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="NavSelected" Color="#353535"/>
    <SolidColorBrush x:Key="NavSelectedText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Outline" Color="#00000000"/>
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="ComboText" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#99DDFF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#000000"/>
    <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FFB3BB"/>
    <SolidColorBrush x:Key="OnDanger" Color="#000000"/>
    <SolidColorBrush x:Key="DisabledBg" Color="#333333"/>
