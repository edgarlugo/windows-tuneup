    <SolidColorBrush x:Key="CautionFg" Color="#FCE100"/>
    <SolidColorBrush x:Key="CautionBg" Color="#433519"/>
    <SolidColorBrush x:Key="CriticalFg" Color="#FF99A4"/>
    <SolidColorBrush x:Key="CriticalBg" Color="#442726"/>
    <SolidColorBrush x:Key="InfoFg" Color="#99EBFF"/>
    <SolidColorBrush x:Key="InfoBg" Color="#1F3347"/>
    <SolidColorBrush x:Key="NeutralBg" Color="#333333"/>
    <SolidColorBrush x:Key="Scrim" Color="#99000000"/>
</ResourceDictionary>
